{
  "mcpServers": {
    "vercel": {
      "command": "mcp-remote",
      "args": ["https://mcp.vercel.com"]
    },
    "expo": {
      "command": "npx",
      "args": ["-y", "expo-mcp-server"]
    },
    "dokploy": {
      "command": "npx",
      "args": ["-y", "@dokploy/mcp"]
    },
    "browserless": {
      "command": "browserless-mcp",
      "args": ["https://mcp.browserless.io/mcp"]
    }
  }
}
